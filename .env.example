# HabitUP — variáveis de ambiente
# Copie este arquivo para `.env` e preencha com as credenciais do seu projeto Supabase.
# NUNCA commite o arquivo .env real.

# Projeto Supabase: encontre em Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica-daqui